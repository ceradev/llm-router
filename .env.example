# Copy to `.env` for local / Docker Compose. Do not commit real secrets.

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/llm_router

# Optional; sent as Bearer when set (OpenRouter /models is often usable without a key).
OPENROUTER_API_KEY=

# When true, run curated DB seed once at startup if llm_models is empty (does not touch API).
SEED_MODELS_ON_STARTUP=false

OPENROUTER_AUTO_SYNC_ON_EMPTY_CATALOG=true
OPENROUTER_SYNC_ON_STARTUP=true
OPENROUTER_ENABLE_PERIODIC_SYNC=true
# Interval for periodic sync (hours; app converts to seconds internally).
OPENROUTER_SYNC_INTERVAL_HOURS=6
