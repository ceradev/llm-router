# Copy to `.env` and fill values. Do not commit real secrets.
# Location: repo root `.env.example` (copy to `.env` next to docker-compose.yml).

# --- Docker / Coolify ---
# Coolify: set "Docker Compose" file to repo-root `docker-compose.yml` (not infra/...).
# That file uses build context `.` so `apps/server` and `apps/web` resolve correctly.
# Local from repo root: `docker compose up --build` with env in this folder or `-env-file`.

# --- Database (required by docker-compose) ---
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password_alphanumeric_recommended>
POSTGRES_DB=<postgres_database>

# --- OpenRouter (required by backend) ---
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=<openrouter_api_key>

# --- Admin API (required by backend) ---
# Same string you enter in the /admin panel (stored in sessionStorage after verification).
# Generate a long random string; do not reuse database passwords.
ADMIN_API_KEY=<admin_api_key_long_random>

# --- Frontend public (build/runtime) ---
# Browser → API: inside Docker use http://backend:8000; from host dev use http://127.0.0.1:8001
PUBLIC_API_BASE_URL=http://backend:8000

# Optional. Leave empty so the admin key is not baked into the image.
PUBLIC_ADMIN_API_KEY=

# --- OpenRouter sync ---
OPENROUTER_AUTO_SYNC_ON_EMPTY_CATALOG=true
SEED_MODELS_ON_STARTUP=false
OPENROUTER_SYNC_ON_STARTUP=true
OPENROUTER_ENABLE_PERIODIC_SYNC=true
OPENROUTER_SYNC_INTERVAL_HOURS=6

# --- Catalog evaluation (optional; matches backend Settings) ---
CATALOG_EVALUATION_AFTER_OPENROUTER_SYNC=true
CATALOG_EVALUATION_MAX_MODELS_PER_RUN=50
CATALOG_EVALUATION_MAX_LIVE_PER_RUN=10
CATALOG_EVALUATION_PROVIDER_ALLOWLIST=
CATALOG_EVALUATION_INCLUDE_VERIFIED_LIVE=false
CATALOG_EVALUATION_LIVE_DELAY_SECONDS=2.0
CATALOG_EVALUATION_ENABLE_IMAGE_TEXT_V2=false
CATALOG_EVALUATION_STRICT_IMAGE_TEXT_CHECKS=true
CATALOG_EVALUATION_ENABLE_FILE_TEXT_V3=false
CATALOG_EVALUATION_STRICT_FILE_TEXT_CHECKS=true
