---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>LLM Router | Smart LLM Model Routing</title>
		<meta
			name="description"
			content="LLM Router analiza tu prompt y recomienda el mejor modelo por costo, velocidad y calidad, con comparativas y alternativas claras."
		/>
		<meta
			name="keywords"
			content="LLM Router, model routing, AI models, OpenAI, Anthropic, benchmark, prompt optimization, costo, velocidad, calidad"
		/>
		<meta name="author" content="LLM Router" />
		<meta name="robots" content="index, follow" />
		<meta name="application-name" content="LLM Router" />
		<meta name="apple-mobile-web-app-title" content="LLM Router" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="LLM Router | Smart LLM Model Routing" />
		<meta
			property="og:description"
			content="Selecciona el mejor modelo para cada prompt con un balance inteligente de costo, velocidad y calidad."
		/>
		<meta property="og:site_name" content="LLM Router" />
		<meta property="og:locale" content="es_419" />
		<meta property="og:image" content="/LLMRouterLogoDark.png" />
		<meta property="og:image:alt" content="LLM Router logo" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="LLM Router | Smart LLM Model Routing" />
		<meta
			name="twitter:description"
			content="Recomendaciones de modelos LLM con enfoque en costo, velocidad y calidad."
		/>
		<meta name="twitter:image" content="/LLMRouterLogoDark.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
		<meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
		<meta name="msapplication-TileColor" content="#0b1220" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('llm-router-theme');
				const theme = stored === 'light' ? 'light' : 'dark';
				document.documentElement.classList.add(theme);
				document.documentElement.classList.toggle('dark', theme === 'dark');
				document.documentElement.classList.toggle('light', theme === 'light');
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="font-sans">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
