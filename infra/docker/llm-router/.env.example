# Copy to `.env` for production. Do not commit real secrets.

# Database - configurable credentials
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_database>

# OpenRouter - get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=<openrouter_api_key>

# Admin - change to a secure random string
ADMIN_API_KEY=<admin_api_key>

# Frontend public runtime/build vars
PUBLIC_API_BASE_URL=http://backend:8000
PUBLIC_ADMIN_API_KEY=

# Sync settings
OPENROUTER_AUTO_SYNC_ON_EMPTY_CATALOG=true
OPENROUTER_SYNC_ON_STARTUP=true
OPENROUTER_ENABLE_PERIODIC_SYNC=true
OPENROUTER_SYNC_INTERVAL_HOURS=6

# Catalog evaluation (optional)
CATALOG_EVALUATION_AFTER_OPENROUTER_SYNC=true
CATALOG_EVALUATION_MAX_MODELS_PER_RUN=50
CATALOG_EVALUATION_MAX_LIVE_PER_RUN=10
CATALOG_EVALUATION_PROVIDER_ALLOWLIST=
CATALOG_EVALUATION_INCLUDE_VERIFIED_LIVE=false
CATALOG_EVALUATION_LIVE_DELAY_SECONDS=2.0